# Copier ce fichier en .env (jamais commite) et remplir les valeurs avant `docker compose up`
MYSQL_ROOT_PASSWORD=change_me
MYSQL_DATABASE=senyummies
MYSQL_USER=senyummies
MYSQL_PASSWORD=change_me
JWT_SECRET=change_me_generate_a_long_random_string
APP_AUTH_SEED_ENABLED=true
APP_AUTH_SEED_CUISINE_PASSWORD=change_me_cuisine_password
APP_AUTH_SEED_GERANT_PASSWORD=change_me_gerant_password
APP_AUTH_SEED_MANAGER_PASSWORD=change_me_manager_password
APP_AUTH_SEED_LIVREUR_PASSWORD=change_me_livreur_password
APP_AUTH_SEED_VENDEUR_PASSWORD=change_me_vendeur_password

# Profil Spring : dev (defaut, Swagger actif) ou prod (Swagger coupe,
# verification de la configuration au demarrage : JWT_SECRET >= 32 octets et
# different de la valeur par defaut, APP_AUTH_SEED_ENABLED=false).
SPRING_PROFILES_ACTIVE=dev

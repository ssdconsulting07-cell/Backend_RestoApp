# Copier en .env (jamais commite) puis remplacer chaque valeur.
# Secrets obligatoires : docker compose refuse de demarrer s'il en manque un.

MYSQL_ROOT_PASSWORD=a-remplacer
MYSQL_PASSWORD=a-remplacer
# 32 caracteres minimum, aleatoire (ex. : openssl rand -base64 48)
JWT_SECRET=a-remplacer-par-une-chaine-aleatoire-de-32-caracteres-minimum

# Mots de passe des comptes de demonstration (identifiants : cuisine, gerant,
# manager, livreur, vendeur).
MDP_CUISINE=a-remplacer
MDP_GERANT=a-remplacer
MDP_MANAGER=a-remplacer
MDP_LIVREUR=a-remplacer
MDP_VENDEUR=a-remplacer

# Facultatif
# CLIENT_PORT=8081
# MANAGER_PORT=8082
# BACKEND_PORT=8090
# PAIEMENT_SIMULE_MODE=immediat     # ou webhook
# SUPPORT_TELEPHONE=+221XXXXXXXXX
# SUPPORT_EMAIL=support@exemple.sn

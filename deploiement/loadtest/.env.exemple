# Copier en .env (jamais commite). Valeurs JETABLES, propres aux tests de charge.
MYSQL_ROOT_PASSWORD=a-remplacer
MYSQL_PASSWORD=a-remplacer
# 32 caracteres minimum (ex. : openssl rand -base64 48)
JWT_SECRET=a-remplacer-par-une-chaine-aleatoire-de-32-caracteres-minimum

# Mots de passe des comptes staff crees au demarrage ; les memes variables
# sont passees a k6 (voir load-tests/README.md).
K6_MDP_CUISINE=a-remplacer
K6_MDP_GERANT=a-remplacer
K6_MDP_MANAGER=a-remplacer
K6_MDP_LIVREUR=a-remplacer
K6_MDP_VENDEUR=a-remplacer

# Facultatif
# PORT=8380                 # nginx du Client (BASE_URL = http://localhost:8380/api/v1)
# METRIQUES_PORT=9190       # metriques Prometheus du backend
# CLIENT_DIR=../../../Client_RestoApp

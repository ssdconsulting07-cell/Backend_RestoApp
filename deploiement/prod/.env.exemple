# Copier en .env (jamais commite, droits 600) puis renseigner chaque valeur.

# Domaines (DNS deja pointes vers ce serveur) et contact des certificats
DOMAINE_CLIENT=commande.exemple.sn
DOMAINE_MANAGER=gestion.exemple.sn
EMAIL_CERTIFICATS=technique@exemple.sn

# Secrets : longs et aleatoires (ex. openssl rand -base64 48), propres a la prod
MYSQL_ROOT_PASSWORD=a-remplacer
MYSQL_PASSWORD=a-remplacer
JWT_SECRET=a-remplacer

# Premier lancement UNIQUEMENT : premier compte Manager (mot de passe temporaire,
# 12 caracteres minimum, a changer a la premiere connexion). Vider ensuite.
MANAGER_INITIAL_IDENTIFIANT=
MANAGER_INITIAL_MOT_DE_PASSE=

# Prestataire de paiement reel (docs/reste-a-faire.md, 1.1) et ses cles.
PAIEMENT_PRESTATAIRE=a-choisir

# Contact support affiche dans les deux apps
SUPPORT_TELEPHONE=+221XXXXXXXXX
SUPPORT_EMAIL=support@exemple.sn

# Facultatif
# VERSION=1.0.0            # etiquette des images
# SAUVEGARDE_JOURS=14      # duree de conservation des sauvegardes
